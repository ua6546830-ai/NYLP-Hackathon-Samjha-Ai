<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Prevent health data and prescription records from being uploaded to cloud backups -->
        <exclude domain="database" path="samjha_rx.db" />
        <exclude domain="database" path="samjha_rx.db-wal" />
        <exclude domain="database" path="samjha_rx.db-shm" />
        <exclude domain="sharedpref" path="samjha_rx_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="samjha_rx.db" />
    </device-transfer>
</data-extraction-rules>
